# Copy to .env and fill secrets. Do not commit .env.

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=revenue_recovery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka — host process bootstrap (Spring Boot / local Python)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Kafka — container-to-container bootstrap (use from other compose services)
# KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Agent service
ANTHROPIC_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Razorpay Test Mode
# Dashboard: https://dashboard.razorpay.com  (toggle Test Mode ON)
# API Keys: Account & Settings -> API Keys -> Generate Test Keys (rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Use this same string as the webhook secret when registering the endpoint.
# Local simulator signs with it too.
RAZORPAY_WEBHOOK_SECRET=whsec_dev_local
